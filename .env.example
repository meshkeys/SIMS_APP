# Copy to .env at the repo root:  cp .env.example .env
# The server also reads this file (apps/server loads ../../.env).

# --- Infrastructure (docker-compose) ---
# Postgres is published on 5433 so it never collides with a locally installed Postgres on 5432.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sims
POSTGRES_PORT=5433
APP_DB_USER=sims_app
APP_DB_PASSWORD=sims_app
REDIS_PORT=6379
SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Server ---
NODE_ENV=development
PORT=3000
# Runtime connection: the least-privileged app role (row-level security applies).
DATABASE_URL=postgresql://sims_app:sims_app@localhost:5433/sims
# Migrations and seeding: the table-owner role.
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5433/sims

# --- Auth ---
# Generate a strong key per environment: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-random-48-byte-base64-string-xxxxxxxx
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Refresh cookie over HTTPS only (always true in production).
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173

# --- Email & links ---
# Public address of the web app (used in email links).
APP_URL=http://localhost:5173
# Local SMTP is Mailpit: read sent mail at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=SIMS <no-reply@sims.local>

# --- API reference ---
# /api/docs and /api/openapi.json; on by default except in production.
# API_DOCS=true

# --- Tests (e2e/integration run against a separate database) ---
TEST_DATABASE_URL=postgresql://sims_app:sims_app@localhost:5433/sims_test
TEST_DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5433/sims_test

# --- File storage (evidence, board packs) ---
# local: files under apps/server/var/storage. s3: any S3-compatible service.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=var/storage
# S3_BUCKET=sims-files
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
UPLOAD_MAX_MB=20

# --- Background jobs (board pack generation) ---
REDIS_URL=redis://localhost:6379
# bullmq (through Redis, default) or inline (run at once; tests)
JOBS_DRIVER=bullmq
# Process jobs in this server (turn off on API-only instances)
JOBS_WORKER=true
# Chrome/Chromium for PDF packs (found automatically when unset)
# CHROME_PATH=/usr/bin/chromium
